# Copy to .env.local. With nothing set the game runs in local mode: no server, and
# tabs of the same browser share one room (good for trying it out).

# Multiplayer: an MQTT-over-WebSocket broker.
#   /api/mqtt                    the broker in this repo (Vercel Function or `npm run dev` + REDIS_URL)
#   wss://broker.example/mqtt    any MQTT 3.1.1 broker you run (EMQX, Mosquitto, …)
VITE_MQTT_URL=
VITE_MQTT_USER=
VITE_MQTT_PASS=
VITE_ROOM=main

# Default language before a player picks one: zh or en (unset = en)
VITE_LANG=

# Server only (the /api/mqtt broker). Never prefix with VITE_.
REDIS_URL=
MQTT_ROOM=main
